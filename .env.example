# Production settings
ABHEDYA_ENV=production
ABHEDYA_API_KEY=replace-with-at-least-32-random-characters
ABHEDYA_DATA_DIR=/var/lib/abhedya/data
ABHEDYA_MAX_UPLOAD_BYTES=2147483648
ABHEDYA_RATE_LIMIT=120
ABHEDYA_RATE_WINDOW_SECONDS=60
# Set these when running behind a reverse proxy
ABHEDYA_TRUSTED_HOSTS=127.0.0.1,localhost
ABHEDYA_ALLOWED_ORIGINS=
